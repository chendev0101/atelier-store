{
  "permissions": {
    "allow": [
      "Bash(pnpm run *)",
      "Bash(pnpm start)",
      "Bash(pnpm build)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm db:generate)",
      "Bash(pnpm db:studio)",
      "Bash(pnpm db:seed)",
      "Bash(pnpm lint)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git commit *)",
      "Bash(git pull)",
      "Bash(git fetch)",
      "Bash(git merge)",
      "Bash(git rebase)"
    ],
    "ask": ["Bash(git push *)", "Bash(pnpm db:push)", "Bash(pnpm db:migrate)"],
    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.*.local)",
      "Read(.env.production)",
      "Edit(.env)",
      "Edit(.env.local)",
      "Edit(.env.*.local)",
      "Edit(.env.production)"
    ]
  }
}
