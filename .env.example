# Copy to .env.local and fill in values. Never commit real secrets.

# Neon Postgres connection string (use the pooled URL from the Neon console)
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require"

# Better Auth — generate with: pnpm dlx @better-auth/cli secret  (or: openssl rand -base64 32)
BETTER_AUTH_SECRET=""
# Base URL of the app (server side)
BETTER_AUTH_URL="http://localhost:3000"

# Public base URL used by the browser auth client
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google sign-in (optional; the button is hidden until both are set).
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Stripe — use test-mode keys in development (Dashboard → Developers → API keys).
# Secret key (sk_test_...) or a restricted key (rk_test_...). Server only.
STRIPE_SECRET_KEY=""
# Webhook signing secret (whsec_...). Locally, printed by: stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=""
# Only needed if payment forms are embedded with Stripe Elements; not used by hosted Checkout.
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
